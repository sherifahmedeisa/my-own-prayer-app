<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="App Icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prayer Times"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cairo, Egypt"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_theme_toggle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/button_outline_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp"
                android:text="🎨 Dark"
                android:textColor="@color/gold"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sync_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_gold_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Offline Ready"
                android:textColor="@color/gold"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hero Countdown Card -->
        <LinearLayout
            android:id="@+id/card_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="22dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_hero_next_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXT PRAYER"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hero_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Fajr · الفجر"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hero_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="00:00:00"
                android:textColor="@color/gold"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hero_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Today at 5:30 AM"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Daily Prayer Times Schedule Card -->
        <LinearLayout
            android:id="@+id/card_schedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_schedule_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY'S SCHEDULE"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Fajr -->
            <LinearLayout
                android:id="@+id/row_fajr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical">
                <TextView android:id="@+id/name_fajr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Fajr · الفجر" android:textColor="@color/text_primary" android:textSize="15sp" />
                <TextView android:id="@+id/time_fajr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Sunrise -->
            <LinearLayout
                android:id="@+id/row_sunrise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical">
                <TextView android:id="@+id/name_sunrise" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sunrise · الشروق" android:textColor="@color/text_secondary" android:textSize="14sp" />
                <TextView android:id="@+id/time_sunrise" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="@color/text_secondary" android:textSize="14sp" />
            </LinearLayout>

            <!-- Dhuhr -->
            <LinearLayout
                android:id="@+id/row_dhuhr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical">
                <TextView android:id="@+id/name_dhuhr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Dhuhr · الظهر" android:textColor="@color/text_primary" android:textSize="15sp" />
                <TextView android:id="@+id/time_dhuhr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Asr -->
            <LinearLayout
                android:id="@+id/row_asr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical">
                <TextView android:id="@+id/name_asr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Asr · العصر" android:textColor="@color/text_primary" android:textSize="15sp" />
                <TextView android:id="@+id/time_asr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Maghrib -->
            <LinearLayout
                android:id="@+id/row_maghrib"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical">
                <TextView android:id="@+id/name_maghrib" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Maghrib · المغرب" android:textColor="@color/text_primary" android:textSize="15sp" />
                <TextView android:id="@+id/time_maghrib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Isha -->
            <LinearLayout
                android:id="@+id/row_isha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical">
                <TextView android:id="@+id/name_isha" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Isha · العشاء" android:textColor="@color/text_primary" android:textSize="15sp" />
                <TextView android:id="@+id/time_isha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Prayer Reminders & Haptics Settings Card -->
        <LinearLayout
            android:id="@+id/card_reminders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_reminders_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔 PRAYER REMINDERS &amp; HAPTICS"
                android:textColor="@color/gold"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Master Toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">
                <TextView
                    android:id="@+id/tv_remind_master_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enable Reminders"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <Switch
                    android:id="@+id/switch_reminders_master"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 15m Before -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">
                <TextView
                    android:id="@+id/tv_remind_before_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="15 minutes BEFORE prayer"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
                <Switch
                    android:id="@+id/switch_remind_before"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 15m After -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">
                <TextView
                    android:id="@+id/tv_remind_after_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="15 minutes AFTER prayer"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
                <Switch
                    android:id="@+id/switch_remind_after"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Haptic Vibration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">
                <TextView
                    android:id="@+id/tv_haptic_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Haptic Feedback (Vibrate)"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
                <Switch
                    android:id="@+id/switch_haptic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Test Reminder Button -->
            <Button
                android:id="@+id/btn_test_reminder"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_outline_bg"
                android:text="⚡ Test Haptic &amp; Notification Now"
                android:textColor="@color/gold"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Home Widget Action Card -->
        <LinearLayout
            android:id="@+id/card_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOME SCREEN WIDGET"
                android:textColor="@color/gold"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_widget_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keep track of prayer times with a live live-ticking countdown right on your home screen."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btn_add_widget"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/button_gold_bg"
                android:text="★ Add Widget to Home Screen"
                android:textColor="@color/bg_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Or long-press an empty spot on your home screen &gt; tap Widgets &gt; choose Prayer Times."
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Refresh / Actions Card -->
        <LinearLayout
            android:id="@+id/card_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btn_sync"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/button_outline_bg"
                android:text="↻ Sync Month from UmmahAPI"
                android:textColor="@color/gold"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Location: Cairo, Egypt (30.0444, 31.2357)\nMethod: Egyptian Survey · Madhab: Shafi\nFull month cached for offline use"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
